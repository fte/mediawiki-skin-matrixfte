<footer id="footer" class="mw-footer matrix-footer" role="contentinfo" {{{html-user-language-attributes}}}>
	<div class="matrix-footer-inner">
		<div class="matrix-footer-rows">
			{{#data-info}}{{>FooterRow}}{{/data-info}}
			{{#data-places}}{{>FooterRow}}{{/data-places}}
		</div>
		{{#data-icons}}<div class="matrix-footer-icons">{{>FooterRow}}</div>{{/data-icons}}
		<div class="matrix-footer-quote">{{msg-matrix-footer-quote}}</div>
	</div>
</footer>
